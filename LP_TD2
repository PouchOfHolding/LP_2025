
#include <stdio.h>
#include <time.h>
#include <string.h>
#include <stdlib.h>

typedef struct{                 // separa-se os dados num struct diferente para fazer o manageamento de espaço mais fácil
    char *palavra;
    int count;
} item;

typedef struct dynvec{
    item *data;
    size_t elem_size;
    size_t capacity;
    size_t length;
} dynvec;

void dynvec_free(dynvec *v) {
    if (!v) return;

    for (size_t i = 0; i < v->length; i++) {                // strdup inerentemente tem memory allocation na função, logo precisa ser limpada individualmente
        free(v->data[i].palavra);
    }

    free(v->data);
    free(v);
}

dynvec *dynvec_create(int size){                            // define-se o espaço que vai ocupar
    dynvec *v= malloc(sizeof(dynvec));

    v->length=0;
    v->capacity = 5;
    v->elem_size = size;
    v->data = malloc(v->elem_size * v->capacity);
    
    return v;
}

void dynvec_push(dynvec *v, void *palavra){                             // recebe-se um vetor e um elemento de qualquer tipo
    if(!v || !palavra) return;

    if(v->length == v->capacity) {                                      // no caso de o tamanho chegar à capacidade máxima, faz realloc 
        v->capacity *= 2;
        item *temp = realloc(v->data, v->capacity * sizeof(item)); 
        if(!temp) {
            dynvec_free(v);
            return;
        }
        v->data = temp;
    }

    v->data[v->length].palavra = *(char **)palavra;
    v->length++;
}

void dynvec_show(dynvec *v){                                            // print cada elemeto 'contagem' 'palavra'
    for(size_t i=0; i<v->length;i++){
        printf("%d %s\n", v->data[i].count,v->data[i].palavra);
    }
}

void dynvec_new_size(dynvec *v, size_t n){                              // limpa o dynvec para ter só n quantidade de elementos (v[0] a v[n])
    if (!v || v->length < n) {return;}

    for (size_t i = n; i < v->length; i++) {
        free(v->data[i].palavra);
    }
    item *new_data = realloc(v->data, n*sizeof(item));
    if(!new_data){
        perror("erro em mudança de tamanho");
        return;
    }
    v->data = new_data;
    v->length=n;
    v->capacity=n;
}

//quicksort de palavras
void swap(char **a, char **b) {                                         // swap de strings
    char* temp = *a;
    *a = *b;
    *b = temp;
}

int partition(char **v, int left, int right) {
    char *pivot = v[right];                                             // pivo = ultimo elemento do array     
    int i = left;                                                       // guarda a posição na esquerda da palavra alf. menor     

    for (int j = left; j < right; j++) {
        if (strcmp(v[j], pivot) < 0) {                                  // se palavra[posiçao j] for alfab.mente menor que pivo, muda o lugar de j para i
            swap(&v[i], &v[j]);
            i++;                                                        // move a posição de i +1
        }
    }
    swap(&v[i], &v[right]);                                             // põe o pivô no lugar correto (estará no meio)

    return i;                                                           // retornar o indice o pivo
}

void quickrec(char **v, int left, int right) {
    if (left < right) {                                                 // faz recursividade até passar pelo vetor todo
        int p = partition(v, left, right);                              
        quickrec(v, left, p - 1);                           
        quickrec(v, p + 1, right);                          
    }
}

void quicksort(char **v, int length) {
    if (v && length > 1) {                                              // se o array e length existe, chama a função recursiva que realisa o sorting
        quickrec(v, 0, length - 1);
    }
}

// mergesort utilizado para a ordenação descendente da contagem do dynvec
void merge(item *a, item *temp, int left, int m, int right) {
    int i = left, j = m;                                                // i = inicio da esquerda; j = inicio da direita

    for (int k = left; k < right; k++){                                 
        if (i < m && (j == right || (temp[i].count >= temp[j].count))){  // se i < meio E temp[esquerda] >= temp[direita] OU já nao houver mais elementos à direita
            a[k] = temp[i];                                             // a[atual] = temp[esquerda]
            i++;}                                                       // prox elemento da esquerda
        else{
            a[k] = temp[j];                                             // a[atual] = temp[direita]
            j++;}                                                       // prox elemento da direita
    }
}   

void mergesortrec(item* a, item* temp, int left, int right) {           // merge_sort_recursion > recursividade
    if (right - left <= 1) return;                                      // se estivermos no fim, retorna

    int m = left + (right - left) / 2;                                  // encontrar o meio da função

    mergesortrec(a, temp, left, m);                                     // separação da esquerda - meio
    mergesortrec(a, temp, m, right);                                    // meio - direita

    for (int i = left; i < right; i++)
        temp[i] = a[i];                                                 // array temporario que vai segurar o array a[] original
    merge(a, temp, left, m, right);                                     // chama a função que vai realisar o merge sorting
}

int main(void){
    dynvec *v = dynvec_create(sizeof(item));
    
    const char delim[] = "!$'()*,-.0123456789:;?\n ";

    int quantia=0;

    size_t indice=0,cap=100;

    char **allwords = malloc(cap*sizeof(char*));                        // nao sabemos a quantidade de palavras que vai acabar por ler

    char string[1024];

    scanf("%d",&quantia);

    while (fgets(string, 1024,stdin)!= NULL) {
        char *token = strtok(string, delim);                            // queremos ignorar todos os símbolos guardados em delim[]
        while (token != NULL) {

            if(indice==cap){                                            // se a quantidade de palavras chegar ao limite do string array
                cap*=2;
                allwords=realloc(allwords,cap*sizeof(char*));           // ^ faz realloc
            }

            allwords[indice]=strlwr(strdup(token));                             // guarda-se as palavras todas num array de strings
            indice++;
            token = strtok(NULL, delim);
        }
    }

    quicksort(allwords,indice);                                         // ordena-se alfabeticamente o array de palavras e põe-se os repetidos colados 
 
    for (size_t i = 0; i < indice;) {                                  
        size_t j = i + 1;
        while (j < indice && strcmp(allwords[i], allwords[j]) == 0)
            j++;

        
        dynvec_push(v, &allwords[i]);
        v->data[v->length-1].count =  j - i;
        
        for (size_t k = i + 1; k < j; k++) {                            // limpa-se imediatamente todos os repetidos desta iteração
            free(allwords[k]);
        }

        i = j;                                                          // definir i para continuar loop para a próxima palavra única
    }

    free(allwords);

    item *temp = malloc(v->length * sizeof(item));                      // item temporario para o merge sorting
    mergesortrec(v->data,temp,0,v->length);

    dynvec_new_size(v,quantia);
    dynvec_show(v);
    
    free(temp);
    dynvec_free(v);

    return 0;
}
